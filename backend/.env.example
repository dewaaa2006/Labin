# Supabase PostgreSQL connection string.
# Recommended: Transaction pooler URL from Supabase Dashboard -> Project Settings -> Database.
# Format:
# postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
JWT_ACCESS_SECRET="super-secret-access-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-prod"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS=30
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="generated-by-ethereal"
SMTP_PASS="generated-by-ethereal"
FROM_EMAIL="noreply@labin.id"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
